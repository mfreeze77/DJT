{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/DJT/djt-evidence-1.0.schema.json",
  "title": "DJT preserved-source evidence exchange v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "djt-evidence/1.0"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^djt:[a-z-]+:[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "const": "mfreeze77/DJT"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "name",
        "revision"
      ],
      "additionalProperties": false
    },
    "raw_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/raw_record"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "source_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_version"
      }
    },
    "acquisitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acquisition"
      }
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_link"
      }
    },
    "financials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/financial"
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correction"
      }
    },
    "excerpts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excerpt"
      }
    },
    "captures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capture"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "control_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/occurrence"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
