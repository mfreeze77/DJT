{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfreeze77/DJT/djt-story-1.0.schema.json",
  "title": "DJT story selection v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "djt-story/1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "narrative_question": {
      "type": "string",
      "minLength": 1
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14400
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^djt:[a-z-]+:[0-9a-f]{64}$"
      }
    },
    "capture_policy": {
      "enum": [
        "optional",
        "required"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "narrative_question",
    "target_duration_seconds",
    "claim_ids",
    "capture_policy"
  ],
  "additionalProperties": false
}
